<!doctype html>
<html lang="zh-CN">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
  <meta name="theme-color" content="#101518">
  <meta name="description" content="DFM 实时地图，平面地图、2D 模型与 3D 模型自由切换，按需加载当前地图。">
  <title>DFM · 实时雷达</title>
  <link rel="stylesheet" href="https://game.gtimg.cn/images/dfm/cp/a20240729directory/leaflet.css" crossorigin="">
  <link rel="stylesheet" href="./styles.css">
  <link rel="stylesheet" href="./theme.css?v=8">
  <link rel="stylesheet" href="./value.css?v=8">
  <link rel="stylesheet" href="./chat.css?v=8">
  <script defer src="https://game.gtimg.cn/images/dfm/cp/a20240729directory/js/lib/leaflet.js"></script>
<script>
/* ===== WS 诊断：记录每一次 WebSocket 连接（点浮层可关闭） ===== */
(function () {
  /* 默认不显示诊断浮层；需要时在网址后加 ?diag=1 打开（return 必须在函数内！） */
  if (!/[?&]diag=1/.test(location.search)) return;
  var logs = [], el = null;
  function panel() {
    if (el) return el;
    el = document.createElement('pre');
    el.id = 'ws-diag';
    el.style.cssText = 'position:fixed;left:8px;right:8px;bottom:72px;max-height:36vh;overflow:auto;' +
      'background:rgba(8,10,12,.95);color:#9fe8c8;border:1px solid #2f3339;border-radius:10px;' +
      'padding:8px 10px;font:11px/1.55 ui-monospace,SFMono-Regular,Menlo,monospace;z-index:99999;' +
      'white-space:pre-wrap;word-break:break-all;-webkit-overflow-scrolling:touch';
    el.addEventListener('click', function () { el.remove(); el = null; });
    document.body.appendChild(el);
    return el;
  }
  function add(s) {
    var t = new Date().toTimeString().slice(0, 8);
    logs.push('[' + t + '] ' + s);
    if (logs.length > 60) logs.shift();
    var p = panel(); if (p) { p.textContent = logs.join('\n'); p.scrollTop = p.scrollHeight; }
    try { console.log('[WS]', s); } catch (e) {}
  }

  window.__wsDiag = add;
  var Orig = window.WebSocket;
  function Wrapped(url, protocols) {
    add('→ 连接 ' + url);
    var ws = protocols === undefined ? new Orig(url) : new Orig(url, protocols);
    try {
      ws.addEventListener('open', function () { add('  ✅ 已连接'); });
      ws.addEventListener('error', function () { add('  ❌ 连接错误'); });
      ws.addEventListener('close', function (e) {
        add('  ⛔ 关闭 code=' + e.code + (e.reason ? ' reason=' + e.reason : '') +
            '  [1006=网络/被拦 4004=房间不存在]');
      });
    } catch (e) { add('  监听失败 ' + e.message); }
    return ws;
  }
  Wrapped.prototype = Orig.prototype;
  ['CONNECTING', 'OPEN', 'CLOSING', 'CLOSED'].forEach(function (k, i) { Wrapped[k] = i; });
  window.WebSocket = Wrapped;
  add('WS 诊断已启用（点此浮层可关闭）');
  window.addEventListener('error', function (ev) {
    if (ev && ev.message) add('页面错误: ' + ev.message);
  });
  window.addEventListener('unhandledrejection', function (ev) {
    try { add('未处理异常: ' + (ev.reason && ev.reason.message || ev.reason)); } catch (e) {}
  });
})();
</script>
<script>
/* ===== 卡密验证门 ===== */
(function () {
  var API = 'https://panel.fcefw.dpdns.org/api/key/verify';
  function device() {
    var d = localStorage.getItem('dfm_device');
    if (!d) { d = 'd' + Math.random().toString(36).slice(2, 10) + Date.now().toString(36); localStorage.setItem('dfm_device', d); }
    return d;
  }
  function style() { /* 注入样式 */
    var st = document.createElement('style');
    st.textContent = '#kkey-mask{position:fixed;inset:0;z-index:100000;background:rgba(8,9,11,.94);' +
      'display:grid;place-items:center;padding:20px;font:14px/1.6 -apple-system,BlinkMacSystemFont,"PingFang SC",system-ui,sans-serif;color:#ececf1}' +
      '#kkey-mask .c{width:100%;max-width:360px;background:#16181b;border:1px solid #26292e;border-radius:14px;padding:22px;text-align:center}' +
      '#kkey-mask h2{margin:0 0 6px;font-size:17px}#kkey-mask p{margin:0 0 16px;font-size:12.5px;color:#9aa0a6}' +
      '#kkey-in{width:100%;padding:12px;font:600 16px/1.4 ui-monospace,Menlo,monospace;letter-spacing:2px;text-align:center;' +
      'background:#1c1f23;border:1px solid #2f3339;border-radius:9px;color:#ececf1;outline:none;text-transform:uppercase}' +
      '#kkey-in:focus{border-color:rgba(16,163,127,.55)}' +
      '#kkey-btn{width:100%;margin-top:12px;padding:12px;border:none;border-radius:9px;background:#10a37f;color:#fff;font:600 15px inherit;cursor:pointer}' +
      '#kkey-msg{margin-top:11px;font-size:12.5px;min-height:18px;color:#ef6b73}' +
      '#kkey-badge{position:fixed;left:10px;bottom:calc(10px + env(safe-area-inset-bottom));z-index:99997;background:rgba(16,163,127,.14);' +
      'border:1px solid rgba(16,163,127,.4);color:#7fe3c0;border-radius:999px;padding:3px 10px;font:600 11px/1.5 system-ui,sans-serif}';
    document.head.appendChild(st);
  }
  function show(msg) {
    if (!document.body) { setTimeout(function(){ show(msg); }, 120); return; }
    style();
    if (document.getElementById('kkey-mask')) return;
    var m = document.createElement('div');
    m.id = 'kkey-mask';
    m.innerHTML = '<div class="c"><h2>🔑 请输入卡密</h2>' +
      '<p>本工具需要有效卡密才能使用<br>（一个卡密绑定一台设备）</p>' +
      '<input id="kkey-in" placeholder="XXXX-XXXX-XXXX" autocomplete="off" spellcheck="false">' +
      '<button id="kkey-btn">验证并进入</button>' +
      '<div id="kkey-msg">' + (msg || '') + '</div></div>';
    document.body.appendChild(m);
    var inp = document.getElementById('kkey-in');
    try { inp.focus(); } catch (e) {}
    function go() {
      var v = (inp.value || '').trim().toUpperCase();
      if (v.length < 8) { document.getElementById('kkey-msg').textContent = '请输入完整卡密'; return; }
      document.getElementById('kkey-msg').textContent = '验证中…';
      document.getElementById('kkey-msg').style.color = '#9aa0a6';
      verify(v, false);
    }
    document.getElementById('kkey-btn').addEventListener('click', go);
    inp.addEventListener('keydown', function (e) { if (e.key === 'Enter') go(); });
  }
  function hide() { var m = document.getElementById('kkey-mask'); if (m) m.remove(); }
  function badge(code, days) {
    style();
    var b = document.getElementById('kkey-badge');
    if (!b) { b = document.createElement('div'); b.id = 'kkey-badge'; document.body.appendChild(b); }
    b.textContent = '🔑 ' + code.slice(0, 4) + '****' + code.slice(-4) + (days != null ? ' · 剩 ' + days + ' 天' : '');
    b.title = '卡密 ' + code;
    b.style.display = 'block';
  }
  function verify(k, silent) {
    fetch(API, { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ code: k, device: device() }) })
      .then(function (r) { return r.json(); })
      .then(function (d) {
        if (d && d.ok) {
          localStorage.setItem('dfm_key', k);
          badge(k.toUpperCase(), d.remainDays);
          hide();
        } else {
          localStorage.removeItem('dfm_key');
          var el = document.getElementById('kkey-msg');
          if (el) { el.style.color = '#ef6b73'; el.textContent = (d && d.msg) || '卡密无效'; }
          else { show((d && d.msg) || '卡密无效'); }
        }
      })
      .catch(function () {
        if (silent) { show('网络异常，无法验证卡密（请检查网络后重试）'); }
        else {
          var el = document.getElementById('kkey-msg');
          if (el) { el.style.color = '#ef6b73'; el.textContent = '网络异常，请重试'; }
        }
      });
  }
  /* 等待 DOM 就绪再执行（脚本在 <head> 里，此时 document.body 还是 null） */
  function boot() {
    var saved = localStorage.getItem('dfm_key');
    if (saved) { verify(saved, true); } else { show(''); }
  }
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', boot);
  } else {
    boot();
  }
})();
</script>
  <script type="module" src="./assets/app.js?v=7"></script>
</head>
<body>
  <svg class="icon-library" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
    <symbol id="i-radar" viewBox="0 0 24 24"><circle cx="12" cy="12" r="9"/><circle cx="12" cy="12" r="4"/><path d="M12 12 19 5M12 3v2M3 12h2M12 19v2M19 12h2"/></symbol>
    <symbol id="i-arrow" viewBox="0 0 24 24"><path d="M5 12h14m-6-6 6 6-6 6"/></symbol>
    <symbol id="i-exit" viewBox="0 0 24 24"><path d="M9 4H5v16h4m5-12 4 4-4 4M9 12h11"/></symbol>
    <symbol id="i-plus" viewBox="0 0 24 24"><path d="M5 12h14M12 5v14"/></symbol>
    <symbol id="i-minus" viewBox="0 0 24 24"><path d="M5 12h14"/></symbol>
    <symbol id="i-locate" viewBox="0 0 24 24"><circle cx="12" cy="12" r="6"/><circle cx="12" cy="12" r="1"/><path d="M12 2v4m0 12v4M2 12h4m12 0h4"/></symbol>
    <symbol id="i-fit" viewBox="0 0 24 24"><path d="M9 4H4v5m11-5h5v5M4 15v5h5m11-5v5h-5"/></symbol>
    <symbol id="i-users" viewBox="0 0 24 24"><circle cx="9" cy="8" r="3"/><path d="M3 20v-2a6 6 0 0 1 12 0v2m1-15a3 3 0 0 1 0 6m2 3a5 5 0 0 1 3 4v2"/></symbol>
  </svg>
  <section id="entry-screen" class="entry-screen" aria-labelledby="entry-title">
    <header class="entry-header">
      <a class="brand" href="./" aria-label="DFM 雷达首页"><svg class="brand-icon"><use href="#i-radar"/></svg><span>DFM<span class="brand-divider">/</span><span class="brand-subtitle">RADAR</span></span></a>
      <span class="entry-meta">实时态势 · 同步视野</span>
    </header>
    <main class="entry-main">
      <div class="join-card">
        <div class="entry-emblem" aria-hidden="true"><svg><use href="#i-radar"/></svg></div>
        <p class="eyebrow">ROOM ACCESS</p>
        <h1 id="entry-title">加入雷达房间</h1>
        <p class="entry-description">输入客户端的房间号，即刻同步实时地图。</p>
        <form id="room-form" novalidate>
          <label class="room-label" for="room-code">4 位房间号</label>
          <div id="code-field" class="code-field">
            <div class="code-slots" aria-hidden="true"><span class="code-slot"></span><span class="code-slot"></span><span class="code-slot"></span><span class="code-slot"></span></div>
            <input id="room-code" class="code-input" type="text" inputmode="numeric" pattern="[0-9]{4}" maxlength="4" autocomplete="off" enterkeyhint="go" spellcheck="false" aria-describedby="room-hint form-message" aria-required="true">
          </div>
          <p id="form-message" class="form-message" role="status" aria-live="polite"></p>
          <button id="join-button" class="join-button" type="submit"><span id="join-label">进入雷达</span><svg class="icon join-arrow" aria-hidden="true"><use href="#i-arrow"/></svg><span class="spinner" aria-hidden="true"></span></button>
          <p id="room-hint" class="room-hint">请先在客户端开启共享，获取房间号</p>
        </form>
        <div class="entry-note"><span class="note-line"></span><span>平面地图 / 2D 模型 / 3D 模型</span><span class="note-line"></span></div>
      </div>
    </main>
    <footer class="entry-footer"><span>DFM PLUS</span><span>PC / ANDROID</span></footer>
  </section>
  <section id="radar-screen" class="radar-screen" hidden aria-label="实时雷达工作台">
    <header class="radar-header">
      <div class="brand radar-brand"><svg class="brand-icon" aria-hidden="true"><use href="#i-radar"/></svg><span>DFM<span class="brand-divider">/</span><span class="brand-subtitle">RADAR</span></span></div>
      <div class="map-heading"><span class="eyebrow">当前地图</span><h1 id="map-name" tabindex="-1">等待识别地图</h1><span class="auto-badge">自动同步</span></div>
      <div class="room-actions"><div class="room-badge"><span>房间</span><strong id="active-room">----</strong></div><button id="leave-button" class="leave-button" type="button" title="退出房间"><svg class="icon" aria-hidden="true"><use href="#i-exit"/></svg><span>退出</span></button></div>
    </header>
    <div class="view-bar">
      <div class="view-switch" role="group" aria-label="地图显示方式">
        <button type="button" data-mode="flat" aria-pressed="true">平面地图</button>
        <button type="button" data-mode="model2d" aria-pressed="false">2D 模型</button>
        <button type="button" data-mode="model3d" aria-pressed="false">3D 模型</button>
      </div>
      <div id="model-options" class="model-options" hidden>
        <div id="ally-view-control" class="ally-view-control" hidden>
          <label for="ally-view">3D 视角</label>
          <select id="ally-view" aria-describedby="ally-view-status"><option value="">自由观察</option></select>
          <span id="ally-view-status" class="visually-hidden" role="status">选择友方，切换跟随视角</span>
        </div>
        <label>范围 <select id="model-radius"><option value="150">150 米</option><option value="300">300 米</option><option value="all">全图（高负载）</option></select></label>
        <label><input id="model-xray" type="checkbox" checked>墙后标记</label>
        <span id="model-gesture">拖动旋转 · 右键 / 双指平移 · 双击表面定位</span>
      </div>
    </div>
    <main class="radar-workspace">
      <div id="radar-map" class="radar-map" role="region" aria-label="雷达地图，可拖动平移、滚轮或双指缩放"></div>
      <div id="model-map" class="model-map" role="region" aria-label="当前地图模型" hidden></div>
      <div id="model-loading" class="model-loading surface" role="status" aria-live="polite" hidden>
        <strong id="model-loading-text">准备当前地图模型…</strong>
        <progress id="model-progress" max="1" value="0" aria-label="当前地图下载进度"></progress>
        <p>仅下载当前地图；切回平面地图可取消加载。</p>
        <button id="model-retry" class="secondary-button" type="button" hidden>重试当前地图</button>
      </div>
      <div class="connection-hud surface" role="status" aria-live="polite"><span id="connection-dot" class="status-dot" data-tone="waiting"></span><span id="connection-label">正在连接</span></div>
      <div id="map-notice" class="map-notice" role="status" hidden></div>
      <div id="coordinate-notice" class="coordinate-notice" role="status" hidden>部分位置缺少高度或世界原点，未显示在模型中。模型可浏览；平面地图仍可查看全部位置。</div>
      <div id="map-empty" class="map-empty">
        <div class="empty-symbol" aria-hidden="true"><svg><use href="#i-radar"/></svg></div>
        <h2 id="empty-title">等待客户端数据</h2>
        <p id="empty-description">进入对局后，地图和位置会自动出现在这里。</p>
        <button id="reload-button" class="secondary-button" type="button" hidden>重新加载页面</button>
      </div>
      <div class="map-tools surface" role="group" aria-label="地图控制">
        <button id="locate-button" class="tool-button" type="button" aria-label="定位友方" title="定位所选友方，未选择时定位首位友方" disabled><svg class="icon" aria-hidden="true"><use href="#i-locate"/></svg></button>
        <span class="tool-divider"></span>
        <button id="zoom-in-button" class="tool-button" type="button" aria-label="放大地图" title="放大地图" disabled><svg class="icon" aria-hidden="true"><use href="#i-plus"/></svg></button>
        <button id="zoom-out-button" class="tool-button" type="button" aria-label="缩小地图" title="缩小地图" disabled><svg class="icon" aria-hidden="true"><use href="#i-minus"/></svg></button>
        <span class="tool-divider"></span>
        <button id="fit-button" class="tool-button" type="button" aria-label="查看全图" title="查看全图" disabled><svg class="icon" aria-hidden="true"><use href="#i-fit"/></svg></button>
      </div>
      <div class="radar-bottom">
        <div id="model-stats" class="model-stats"></div>
        <div class="legend surface" aria-label="标记图例与数量">
          <div class="legend-item"><span class="marker-key key-ally"></span><span>友方</span><strong id="ally-count">—</strong></div>
          <div class="legend-item"><span class="marker-key key-player"></span><span>敌方</span><strong id="player-count">—</strong></div>
          <div class="legend-item"><span class="marker-key key-bot"></span><span>人机</span><strong id="bot-count">—</strong></div>
          <div class="legend-item"><span class="marker-key key-item"></span><span>物资</span><strong id="item-count">—</strong></div>
        </div>
        <div class="session-meta surface"><span class="online-count"><svg class="icon" aria-hidden="true"><use href="#i-users"/></svg><span><strong id="peer-count">0</strong> 在线</span></span><span class="meta-divider"></span><span id="data-age">尚无数据</span></div>
      </div>
    </main>
  </section>
  <noscript><div class="noscript-notice">请启用 JavaScript 后使用实时雷达。</div></noscript>
  <script src="./patch.js?v=8"></script>
  <script src="./debug.js?v=8"></script>
  <script src="./value.js?v=8"></script>
  <script src="./chat.js?v=10"></script>
</body>
</html>
